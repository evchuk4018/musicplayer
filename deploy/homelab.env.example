# Copy these values into the private musicplayer compose environment on homelab.
# Keep this file out of Git if it contains real passwords.
MUSICPLAYER_POSTGRES_DB=musicplayer
MUSICPLAYER_POSTGRES_USER=musicplayer
MUSICPLAYER_POSTGRES_PASSWORD=replace-with-a-long-random-password
MUSICPLAYER_WEB_PORT=3090
MUSICPLAYER_BASE_PATH=/music
MUSICPLAYER_MUSIC_ROOT=/srv/storage/media/music
MUSIC_CATALOG_PROVIDER=deezer
ACQUISITION_ENABLED=true
# Set this only when the account owner accepts responsibility for requested downloads.
AUTHORIZED_ACQUISITION=true
SPOTDL_COMMAND=spotdl
SPOTDL_MAX_CONCURRENT=1
RETENTION_DAYS=30
PREFETCH_SIZE=5
NAVIDROME_USER=
NAVIDROME_PASSWORD=
