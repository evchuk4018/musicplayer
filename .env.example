NODE_ENV=development
DATABASE_URL=postgresql://musicplayer:musicplayer@localhost:5432/musicplayer
APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
MUSICPLAYER_POSTGRES_DB=musicplayer
MUSICPLAYER_POSTGRES_USER=musicplayer
MUSICPLAYER_POSTGRES_PASSWORD=change-me
MUSICPLAYER_WEB_PORT=3000
MUSICPLAYER_BASE_PATH=
MUSICPLAYER_MUSIC_ROOT=./data/music
MUSIC_CATALOG_PROVIDER=deezer
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
ACQUISITION_ENABLED=false
